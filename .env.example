# Vorlage fuer die Datei .env. Anlegen mit:   cp .env.example .env
# Die Datei .env selbst ist in .gitignore und kommt NICHT ins Repository.
# Docker Compose liest .env automatisch. Beschreibung aller Variablen: docs/spec-batch-writer.md, 4.4.

# --- Datenbank (postgres, chat-service, batch-writer) ---
POSTGRES_USER=chat
POSTGRES_PASSWORD=chat
POSTGRES_DB=chat

# --- Message Broker (rabbitmq, chat-service, batch-writer) ---
RABBITMQ_DEFAULT_USER=chat
RABBITMQ_DEFAULT_PASS=chat

# --- batch-writer ---
# Hoechstzahl Nachrichten pro Paket (zugleich Prefetch)
BATCH_SIZE=500
# Zeitlimit pro Paket in Millisekunden, gemessen ab der ersten Nachricht
BATCH_TIMEOUT_MS=200
# Pause zwischen zwei Versuchen, wenn die Datenbank nicht antwortet (Millisekunden)
DB_RETRY_PAUSE_MS=2000
