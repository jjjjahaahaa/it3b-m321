<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- Der Spring-Boot-Eltern-POM legt die Versionen aller Spring-Bibliotheken fest.
         Alle Dienste erben sie ueber diesen Eltern-POM, deshalb steht sie nur hier. -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.16</version>
        <relativePath/>
    </parent>

    <groupId>ch.benedict.m321</groupId>
    <artifactId>m321-chat-app</artifactId>
    <version>0.1.0</version>
    <!-- "pom" heisst: dieses Projekt baut selbst nichts, es fasst nur die Dienste zusammen.
         "mvn clean test" im Wurzelverzeichnis laeuft dadurch ueber alle Module. -->
    <packaging>pom</packaging>
    <name>m321-chat-app</name>
    <description>Chat-App aus mehreren Diensten (Modul M321)</description>

    <!-- Die Dienste bleiben einzeln baubar und startbar. Jeder hat sein eigenes Verzeichnis. -->
    <modules>
        <module>chat-service</module>
        <module>batch-writer</module>
    </modules>

    <properties>
        <java.version>21</java.version>
    </properties>
</project>
